# Copiar para `apps/pdf-sources/.env` (o Electron principal lê este ficheiro ao arrancar).
# Não exponhas segredos em variáveis `VITE_*` — vão parar ao bundle do browser.

# Hugging Face (opcional; proxy /hf-hub em dev)
HF_TOKEN=

# Alvo do proxy Vite `/lm-studio` em desenvolvimento (API OpenAI-compatible do LM Studio).
# Por defeito o código já usa a mesma máquina; esta linha deixa o URL explícito.
VITE_LM_STUDIO_TARGET=http://127.0.0.1:1234
# LM Studio noutro PC na LAN (exemplo):
# VITE_LM_STUDIO_TARGET=http://192.168.1.10:1234
#
# LM Link (docs LM Studio): com o link activo, a REST API em localhost/127.0.0.1 pode ser servida
# por um modelo noutro equipamento na rede — continue a usar o URL local do LM Studio aqui; o
# encaminhamento é feito dentro do LM Studio. O dispositivo preferido é por máquina.

# Build estático: URL completa da API (sobrepor o proxy; produção sem LM Studio na mesma máquina)
# VITE_LLM_API_BASE=https://...

# Performance (PDF)
# OCR em todas as páginas é muito mais lento. Use 0 para só OCR onde há bitmap (defeito mais rápido).
# VITE_PDF_OCR_ALL_PAGES=0
# Visão (LLM) — pedidos **sequenciais** (um de cada vez). `temperature: 0` no API.
# Escala raster antes do recorte JPEG (omitir ≈ 2.5).
# VITE_VISION_SCALE=2.5
# Lado mais comprido em px após raster (omitir ≈ 1536). 0 = não redimensionar.
# VITE_VISION_MAX_LONG_EDGE=1536
# Pausa entre páginas (ms), se o LM Studio falhar sob carga.
# VITE_VISION_COOLDOWN_MS=400
